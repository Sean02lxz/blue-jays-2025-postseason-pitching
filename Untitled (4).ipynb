    ]

    # Separate Toronto and opponent pitchers
    tor = series_data[
        series_data["pitching_team"] == "TOR"
    ]

    opponents = series_data[
        series_data["pitching_team"] != "TOR"
    ]

    plt.figure(figsize=(12, 7))

    # Opponent pitchers
    plt.scatter(
        opponents["total_pa_faced"],
        opponents["woba_allowed"],
        color="gray",
        s=90,
        alpha=0.7,
        label="Opponent Pitchers"
    )

    # Blue Jays pitchers
    plt.scatter(
        tor["total_pa_faced"],
        tor["woba_allowed"],
        color="blue",
        s=100,
        alpha=0.8,
        label="Blue Jays Pitchers"
    )

    # Label Toronto pitchers
    for _, player in tor.iterrows():
        plt.annotate(
            player["player_name"],
            (player["total_pa_faced"], player["woba_allowed"]),
            xytext=(5, 5),
            textcoords="offset points",
            fontsize=8
        )

    plt.xlabel("Qualifying PA Faced (Within Series)")
    plt.ylabel("Series wOBA Allowed")
    plt.title(f"2025 Postseason: {series}")

    plt.legend()
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.show()
Visualized individual pitchers by series (Blue dots - TOR), (Grey dots - Opposing team)
Now we identify TOR vs Opponent pitcher pairs with similar workloads within each series, just like we did for RQ2
We will have 2 conditionns, both pitchers must have: 
at least 10 qualifying plate appearances within that series and their workloads must differ by no more than 10 qualifying plate appearances
from itertools import product

series_pairs_list = []

for series in series_order:

    # Select pitchers from this series
    data = pitcher_series[
        (pitcher_series["series"] == series) &
        (pitcher_series["total_pa_faced"] >= 10)
    ]

    # Separate Toronto and opposing pitchers
    tor = data[data["pitching_team"] == "TOR"]
    opp = data[data["pitching_team"] != "TOR"]

    # Compare every Toronto pitcher with opposing pitchers
    for (_, a), (_, b) in product(tor.iterrows(), opp.iterrows()):

        pa_diff = abs(a["total_pa_faced"] - b["total_pa_faced"])

        if pa_diff <= 10:
            series_pairs_list.append({
                "Series": series,
                "TOR Pitcher": a["player_name"],
                "Opponent Pitcher": b["player_name"],
                "TOR PA": a["total_pa_faced"],
                "Opponent PA": b["total_pa_faced"],
                "PA Difference": pa_diff,
                "TOR wOBA Allowed": a["woba_allowed"],
                "Opponent wOBA Allowed": b["woba_allowed"],
                "wOBA Difference": (
                    a["woba_allowed"] - b["woba_allowed"]
                )
            })

series_pairs = pd.DataFrame(series_pairs_list)

series_pairs.head()
We're comparing pitchers only within the same series. A Blue Jays pitcher from the ALDS will only be compared against opposing team which is Yankees pitchers.
series_pairs.sort_values(
    ["Series", "PA Difference"]
)
